digraph MagicDeps {
  rankdir=LR;
  node [style=filled, fontname="Helvetica"];
  subgraph cluster_0 {
    label="raw_circuit";
    style=dashed;
    n0 [label="T-gate\n(magic state required\nonce lowered)\nraw_circuit.mlir:8:11", shape=doubleoctagon, fillcolor=orange];
    n1 [label="arg0\n(logical qubit)", shape=ellipse, fillcolor=lightblue];
    n2 [label="T-gate\n(magic state required\nonce lowered)\nraw_circuit.mlir:9:11", shape=doubleoctagon, fillcolor=orange];
    n3 [label="T-gate\n(magic state required\nonce lowered)\nraw_circuit.mlir:10:11", shape=doubleoctagon, fillcolor=orange];
    n4 [label="arg1\n(logical qubit)", shape=ellipse, fillcolor=lightblue];
    n5 [label="return", shape=cds, fillcolor=white];
  }
  n1 -> n0;
  n0 -> n2;
  n4 -> n3;
  n2 -> n5;
  n3 -> n5;
}
